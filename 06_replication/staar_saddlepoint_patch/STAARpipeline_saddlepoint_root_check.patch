+// ---- rootcheck patch (2026-10-19) -----------------------------------------------------------------
+// STAARpipeline carries its own private copy of the STAAR saddlepoint solver in this file. The same
+// root verification as in the patched STAAR package is applied here: NR_Binary_SPA verifies the score
+// equation at its returned iterate (polishing when needed) and returns NA_REAL otherwise;
+// Bisection_Binary_SPA expands its bracket, converges to the score-equation tolerance and returns
+// NA_REAL when it cannot; Saddle_Binary_SPA* return NA_REAL on NA roots; the caller keeps NA (not 1)
+// when both solvers fail. Diagnostic events are appended to the file named by STAAR_ROOTCHECK_LOG
+// (columns as in STAAR/src/rootcheck.cpp, pkg = STAARpipeline).
+static const double ROOTCHECK_RTOL = 1e-6;
+static long   rc_call_seq   = 0;
+static int    rc_n_variants = -1;
+static double rc_cmac       = -1.0;
+static int    rc_wn         = -1;
+static int    rc_component  = -1;
+static double rc_p_normal   = -1.0;
+static char   rc_context[512] = "";
+
+static double rootcheck_rtol(double q)
+{
+	double s = fabs(q);
+	if(s < 1.0) s = 1.0;
+	return ROOTCHECK_RTOL * s;
+}
+
+static double rootcheck_K1(double x, arma::vec muhat, arma::vec G, double q)
+{
+	double r = K1_Binary_SPA(x, muhat, G, q);
+	if((R_finite(r)==0)||(check_is_na(r)))
+	{
+		r = K1_Binary_SPA_alt(x, muhat, G, q);
+	}
+	return r;
+}
+
+static void rootcheck_set_call(int n_variants, double cmac, int wn)
+{
+	rc_call_seq = rc_call_seq + 1;
+	rc_n_variants = n_variants;
+	rc_cmac = cmac;
+	rc_wn = wn;
+	rc_component = -1;
+	rc_p_normal = -1.0;
+	const char* c = std::getenv("STAAR_ROOTCHECK_CONTEXT");
+	if(c == NULL)
+	{
+		rc_context[0] = '\0';
+	}else
+	{
+		std::strncpy(rc_context, c, sizeof(rc_context) - 1);
+		rc_context[sizeof(rc_context) - 1] = '\0';
+		for(char* p = rc_context; *p != '\0'; ++p)
+		{
+			if((*p == '\t')||(*p == '\n')||(*p == '\r')) *p = ' ';
+		}
+	}
+}
+
+static void rootcheck_set_component(int component, double p_normal)
+{
+	rc_component = component;
+	rc_p_normal = p_normal;
+}
+
+static void rootcheck_log(const char* event, double q, double x_newton, double resid_newton, double x_final, double resid_final, int iter)
+{
+	const char* f = std::getenv("STAAR_ROOTCHECK_LOG");
+	if(f == NULL || f[0] == '\0') return;
+	FILE* fp = std::fopen(f, "a");
+	if(fp == NULL) return;
+	std::fprintf(fp, "STAARpipeline\t%ld\t%d\t%.12g\t%d\t%d\t%.10g\t%s\t%s\t%.17g\t%.17g\t%.17g\t%.17g\t%.17g\t%d\t%s\tNA\n",
+	             rc_call_seq, rc_n_variants, rc_cmac, rc_wn, rc_component, rc_p_normal,
+	             (q < 0 ? "lower" : "upper"), event, q, x_newton, resid_newton, x_final, resid_final, iter, rc_context);
+	std::fclose(fp);
+}
+// ---- end of rootcheck helpers ---------------------------------------------------------------------
