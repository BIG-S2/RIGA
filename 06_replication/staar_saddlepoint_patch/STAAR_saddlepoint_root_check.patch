diff -ruN -x '*.o' -x '*.so' -x .git a/src/rootcheck.cpp b/src/rootcheck.cpp
--- a/src/rootcheck.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/src/rootcheck.cpp	2026-10-19 13:09:30.881876955 -0400
@@ -0,0 +1,115 @@
+// rootcheck.cpp -- helpers added by the 2026-10-19 saddlepoint root-verification patch
+// (ukb_rootcheck_20261019). Not Rcpp-exported; linked into STAAR.so like every other src file.
+//
+// 1. rootcheck_rtol(q): the score-equation tolerance |K1(x) - q| <= 1e-6 * max(1, |q|).
+// 2. rootcheck_K1(): K1 with the package's alternative formula when the primary one is not finite.
+// 3. A diagnostic log. If the environment variable STAAR_ROOTCHECK_LOG names a file, one tab-separated
+//    line is appended for every saddlepoint root EVENT (Newton failure, Newton polish, bisection use)
+//    and one "call_done" line at the end of every burden call (STAAR_B_*SPA* caller). Nothing is written
+//    for a verified Newton root, so the cost is a few file appends per burden call.
+//    Columns (17): pkg, call_seq, n_variants, cMAC, n_weights, component, p_normal, tail, event, q,
+//                  x_newton, resid_newton, x_final, resid_final, iter, context, n_spa
+//    call_seq numbers the burden calls within the R session (one per STAAR_Binary_SPA call); component is
+//    the 0-based weight column; p_normal is the normal-approximation p that sent the component into SPA
+//    (NA when the caller has no filter); context is the value of the environment variable
+//    STAAR_ROOTCHECK_CONTEXT at the start of the call (the patched STAARpipeline sets it to
+//    "<gene>|<category>" before every gene-centric coding call; empty otherwise); n_spa is, on a call_done
+//    line, the number of components of the call that entered the saddlepoint branch (-1 on event lines).
+//    Event lines carry NA in n_spa, call_done lines carry NA in the solver fields.
+
+#define ARMA_64BIT_WORD 1
+#include <RcppArmadillo.h>
+#include <Rcpp.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <math.h>
+
+using namespace Rcpp;
+
+double K1_Binary_SPA(double x, arma::vec muhat, arma::vec G, double q);
+double K1_Binary_SPA_alt(double x, arma::vec muhat, arma::vec G, double q);
+bool check_is_na(double x);
+
+static const double ROOTCHECK_RTOL = 1e-6;
+
+double rootcheck_rtol(double q)
+{
+	double s = fabs(q);
+	if(s < 1.0) s = 1.0;
+	return ROOTCHECK_RTOL * s;
+}
+
+double rootcheck_K1(double x, arma::vec muhat, arma::vec G, double q)
+{
+	double r = K1_Binary_SPA(x, muhat, G, q);
+	if((R_finite(r)==0)||(check_is_na(r)))
+	{
+		r = K1_Binary_SPA_alt(x, muhat, G, q);
+	}
+	return r;
+}
+
+static long   rc_call_seq   = 0;
+static int    rc_n_variants = -1;
+static double rc_cmac       = -1.0;
+static int    rc_wn         = -1;
+static int    rc_component  = -1;
+static double rc_p_normal   = -1.0;
+static int    rc_n_spa      = 0;
+static char   rc_context[512] = "";
+
+void rootcheck_set_call(int n_variants, double cmac, int wn)
+{
+	rc_call_seq = rc_call_seq + 1;
+	rc_n_variants = n_variants;
+	rc_cmac = cmac;
+	rc_wn = wn;
+	rc_component = -1;
+	rc_p_normal = -1.0;
+	rc_n_spa = 0;
+	const char* c = std::getenv("STAAR_ROOTCHECK_CONTEXT");
+	if(c == NULL)
+	{
+		rc_context[0] = '\0';
+	}else
+	{
+		std::strncpy(rc_context, c, sizeof(rc_context) - 1);
+		rc_context[sizeof(rc_context) - 1] = '\0';
+		for(char* p = rc_context; *p != '\0'; ++p)
+		{
+			if((*p == '\t')||(*p == '\n')||(*p == '\r')) *p = ' ';
+		}
+	}
+}
+
+void rootcheck_set_component(int component, double p_normal)
+{
+	rc_component = component;
+	rc_p_normal = p_normal;
+	rc_n_spa = rc_n_spa + 1;
+}
+
+void rootcheck_log(const char* event, double q, double x_newton, double resid_newton, double x_final, double resid_final, int iter)
+{
+	const char* f = std::getenv("STAAR_ROOTCHECK_LOG");
+	if(f == NULL || f[0] == '\0') return;
+	FILE* fp = std::fopen(f, "a");
+	if(fp == NULL) return;
+	std::fprintf(fp, "STAAR\t%ld\t%d\t%.12g\t%d\t%d\t%.10g\t%s\t%s\t%.17g\t%.17g\t%.17g\t%.17g\t%.17g\t%d\t%s\tNA\n",
+	             rc_call_seq, rc_n_variants, rc_cmac, rc_wn, rc_component, rc_p_normal,
+	             (q < 0 ? "lower" : "upper"), event, q, x_newton, resid_newton, x_final, resid_final, iter, rc_context);
+	std::fclose(fp);
+}
+
+// one summary line per burden call (written by every STAAR_B_*SPA* caller just before it returns)
+void rootcheck_end_call()
+{
+	const char* f = std::getenv("STAAR_ROOTCHECK_LOG");
+	if(f == NULL || f[0] == '\0') return;
+	FILE* fp = std::fopen(f, "a");
+	if(fp == NULL) return;
+	std::fprintf(fp, "STAAR\t%ld\t%d\t%.12g\t%d\t%d\tNA\tnone\tcall_done\tNA\tNA\tNA\tNA\tNA\t0\t%s\t%d\n",
+	             rc_call_seq, rc_n_variants, rc_cmac, rc_wn, -1, rc_context, rc_n_spa);
+	std::fclose(fp);
+}
